<Window x:Class="Hotel.AdminPanel.ControlDatabaseView"
        x:Name="DatabaseControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Панель управления" Height="600" Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        FontSize="18" FontFamily="Montserrat"
        Closing="DatabaseControlWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0"
                             Margin="10" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                    Background="#fdfdfd"
                    CornerRadius="120"
                    Opacity="0.45"
                    Height="65" Width="65"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8 0">
                    <Grid>
                        <materialDesign:PackIcon Kind="Backup"
                                            Width="60"
                                            Height="60"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="Резервное копирование"
                           FontWeight="Regular"
                           Foreground="#7986CB"
                           Margin="10"/>
                <Button Grid.Row="1"
                        x:Name="BackupButton"
                        Margin="10"
                        Background="#5C6BC0"
                        Content="ВЫПОЛНИТЬ"
                        Click="BackupButton_Click"/>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1"
                             Margin="10" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Background="#fdfdfd"
                        CornerRadius="120"
                        Opacity="0.45"
                        Height="65" Width="65"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="8 0">
                    <Grid>
                        <materialDesign:PackIcon Kind="DatabaseImport"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        Background="#fdfdfd"
                        CornerRadius="120"
                        Opacity="0.45"
                        Height="65" Width="65"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="8 0">
                    <Grid>
                        <materialDesign:PackIcon Kind="DatabaseExport"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>

                <Button Grid.Column="0" Grid.Row="1"
                        x:Name="ImportButton"
                        Content="Импорт"
                        Margin="10"
                        Background="#5C6BC0"
                        Click="ImportButton_Click"/>

                <Button Grid.Column="1" Grid.Row="1"
                        x:Name="ExportButton"
                        Content="Экспорт"
                        Margin="10"
                        Background="#5C6BC0"
                        Click="ExportButton_Click"/>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2"
                     Margin="10" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="#fdfdfd"
                        CornerRadius="120"
                        Opacity="0.45"
                        Height="65" Width="65"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="8 0 0 0">
                    <Grid>
                        <materialDesign:PackIcon Kind="SettingsBackupRestore"
                                                Width="60"
                                                Height="60"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="Восстановление базы"
                           FontWeight="Regular"
                           Foreground="#7986CB"
                           Margin="15 10"/>
                <Button Grid.Row="1"
                        x:Name="RestoreButton"
                        Content="ВЫПОЛНИТЬ"
                        Margin="10"
                        Background="#5C6BC0"
                        Click="RestoreButton_Click"/>
            </Grid>
        </materialDesign:Card>

        <Button Grid.Row="3"
                x:Name="ConfigConnectionButton"
                Content="Настроить подключение"
                Margin="0 0 0 10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Foreground="#969ecd"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="ConfigConnectionButton_Click"/>
    </Grid>
</Window>
