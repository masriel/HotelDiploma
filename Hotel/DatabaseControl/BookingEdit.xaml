<Window x:Class="Hotel.DatabaseControl.BookingEdit"
        x:Name="BookingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel.DatabaseControl"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Информация о бронировании" Height="370" Width="750"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        FontSize="21" FontFamily="Montserrat" 
        Foreground="#5C6BC0" FontWeight="Medium"
        Loaded="BookingEditWindow_Loaded"
        Closing="BookingEditWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="BookNumber"
                   Text="A000A" Margin="30 10"
                   FontWeight="ExtraBold" FontSize="40"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="0" Margin="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock Text="ЗАЕЗД:"
                       Margin="10"
                       FontWeight="ExtraBold" FontSize="20"
                       VerticalAlignment="Center"/>
            <DatePicker x:Name="ArrivalDatePicker"
                        FontWeight="DemiBold" FontSize="20"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignDatePicker}"/>

            <TextBlock Text="ВЫЕЗД:"
                       Margin="10"
                       FontWeight="ExtraBold" FontSize="20"
                       VerticalAlignment="Center"/>
            <DatePicker x:Name="DepartureDatePicker"
                        FontWeight="DemiBold" FontSize="20"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignDatePicker}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <TextBlock Text="НОМЕР:"
                       Margin="10"
                       FontWeight="ExtraBold" FontSize="20"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="RoomsFree"
                      FontSize="18"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="ПИТАНИЕ:"
                       Margin="10"
                       FontWeight="ExtraBold" FontSize="20"/>
            <ListBox x:Name="MealsList"
                     VerticalAlignment="Center"
                     FontFamily="Montserrat"
                     Foreground="#5C6BC0"
                     FontSize="16"
                     Style="{StaticResource MaterialDesignChoiceChipListBox}"
                     MouseDoubleClick="MealsList_MouseDoubleClick"/>

            <Button x:Name="AddMeal"
                    ToolTip="Icon"
                    Margin="10"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="AddMeal_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Add}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="10">
            <TextBlock Text="ИТОГ:" Margin="10"
                       FontWeight="ExtraBold" FontSize="30"/>
            <TextBlock FontWeight="DemiBold"
                       FontSize="28"
                       Margin="10">
                <Run x:Name="Amount"/>
                <Run Text="руб."/>
            </TextBlock>
            <Button x:Name="CalculateAmountButton"
                    ToolTip="Icon"
                    Width="30" Height="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CalculateAmountButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Calculator}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
