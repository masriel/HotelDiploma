<Window x:Class="Hotel.DatabaseControl.RoomEdit"
        x:Name="RoomEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Hotel.DatabaseControl"
        mc:Ignorable="d"
        Title="Информация о комнате" Height="370" Width="780"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        FontSize="21" FontFamily="Montserrat" 
        Foreground="#5C6BC0" FontWeight="Medium"
        Loaded="RoomEditWindow_Loaded"
        Closing="RoomEditWindow_Closing">
    <Grid>
        <materialDesign:Card Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height=".3*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Grid.Row="1"
                       x:Name="PhotoRoom"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

                <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         x:Name="TypeRoom"
                         Margin="10" Text="Название/вид комнаты"
                         FontWeight="ExtraBold" FontSize="40"
                         VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignTextBox}"/>

                <materialDesign:Card Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Margin="20 32" Background="#E8EAF6">
                    <Grid Margin="10">
                        <StackPanel Orientation="Vertical"
                                    VerticalAlignment="Top" 
                                    Margin="5">
                            <TextBox x:Name="DescriptionRoom"
                                     TextWrapping="Wrap"
                                     FontSize="18"
                                     Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor."
                                     Style="{StaticResource MaterialDesignTextBox}"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Кол-во посетителей:    "
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="OccupancyRoom"
                                         Text="10"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignTextBox}"/>
                                <TextBlock Text=" чел."
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="5">
                            <TextBox x:Name="CostRoom"
                                     Text="2500"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource MaterialDesignTextBox}"/>
                            <TextBlock Text=" руб./ночь"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
