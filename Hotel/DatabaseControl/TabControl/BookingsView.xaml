<UserControl x:Class="Hotel.DatabaseControl.TabControl.BookingsView"
             x:Name="BookingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Hotel.DatabaseControl.TabControl"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="BookingsWindow_Loaded">
    
    <UserControl.Resources>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#9184b7" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD" />
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD" />
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".1*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0"
                   HorizontalAlignment="Stretch">
            <TextBox Name="SearchText"
                     materialDesign:HintAssist.Hint="Поиск"
                     FontSize="13" Margin="8 5"
                     HorizontalAlignment="Left"
                     Width="300"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     TextChanged="SearchText_TextChanged"/>
        </DockPanel>

        <materialDesign:Card Grid.Row="1"
                     Margin="10">
            <Grid>
                <DataGrid x:Name="Bookings"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#F5F5F5"
                                     Style="{StaticResource MaterialDesignMenu}">
                            <MenuItem Header="УДАЛИТЬ"
                                      Name="DeleteBookingButton"
                                      Click="DeleteBookingButton_Click"/>
                            <MenuItem Header="РЕДАКТИРОВАТЬ"
                                      Name="EditUser"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
