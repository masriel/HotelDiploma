<UserControl x:Class="Hotel.DatabaseControl.TabControl.RoomsAndServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Hotel.DatabaseControl.TabControl"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="550" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#9184b7" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD" />
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD" />
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".15*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0"
                   HorizontalAlignment="Stretch">
            <TextBox Name="SearchText"
                     materialDesign:HintAssist.Hint="Поиск"
                     Margin="8" FontSize="13"
                     DockPanel.Dock="Left"
                     Width="300"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            <Button x:Name="AddUserButton"
                    ToolTip="Icon"
                    BorderThickness="0"
                    Background="Transparent"
                    Width="30" Height="30"
                    HorizontalAlignment="Right"
                    Margin="10" DockPanel.Dock="Right">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Add}"/>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>

        <materialDesign:Card Grid.Row="1"
                             Margin="10">
            <Grid>
                <DataGrid x:Name="Users"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#F5F5F5"
                                     Style="{StaticResource MaterialDesignMenu}">
                            <MenuItem Header="УДАЛИТЬ"
                                      Name="DeleteRoom"/>
                            <MenuItem Header="РЕДАКТИРОВАТЬ"
                                      Name="EditRoom"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
