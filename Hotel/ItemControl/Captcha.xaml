<Window x:Class="Hotel.ItemControl.Captcha"
        x:Name="CaptchaWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Captcha" Height="350" Width="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        FontSize="16" FontFamily="Montserrat"
        Loaded="CaptchaWin_Loaded">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="MaterialDesignInputTextBox"
           BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <materialDesign:Card Margin="10 15 10 30">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.3*"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Image Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                       Name="CaptchaPic"
                       Height="100" Width="165"/>

                <TextBox Grid.Row="1" Grid.Column="0"
                         x:Name="CaptchaText"
                         Margin="8" 
                         materialDesign:HintAssist.Hint="Текст с картинки"
                         Style="{StaticResource MaterialDesignInputTextBox}"/>

                <Button Grid.Row="1" Grid.Column="1"
                        x:Name="RefreshCaptchaButton"
                        ToolTip="Icon"
                        BorderThickness="0"
                        Background="Transparent"
                        Width="30" Height="30"
                        Click="RefreshCaptchaButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Refresh}"/>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                        x:Name="CheckCapthaButton"
                        Margin="10 0" Content="ПРОВЕРИТЬ"
                        Background="#5C6BC0"
                        Click="CheckCaptchaButton_Click"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
