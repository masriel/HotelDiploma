<Window x:Class="Hotel.ItemControl.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Администрирование" Height="130" Width="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        FontSize="12" FontFamily="Montserrat">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <PasswordBox x:Name="PasswordText" Width="200" Margin="0,0,0,10"
                         materialDesign:HintAssist.Hint="Введите пароль администратора"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>
            <Button x:Name="CheckPasswordButton"
                    Content="OK" Width="100"
                    Click="CheckPasswordButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
