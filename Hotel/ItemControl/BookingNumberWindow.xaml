<Window x:Class="Hotel.ItemControl.BookingNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel.ItemControl"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/controls"
        xmlns:controls1="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Поиск бронирования" Height="130" Width="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        FontSize="12" FontFamily="Montserrat">

    <Window.Resources>
        <Style x:Key="MaskedTextBox" TargetType="controls1:MaskedTextBox">
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="FontSize" Value="35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <controls1:MaskedTextBox x:Name="BookingNumberText" Width="200" Margin="0,0,0,10"
                                     Mask="A000A"
                                     Style="{StaticResource MaskedTextBox}"/>
            <Button x:Name="SearchBookingButton"
                    Content="НАЙТИ" Width="100"
                    Click="SearchBookingButton_Click"/>
        </StackPanel>
    </Grid>
</Window>