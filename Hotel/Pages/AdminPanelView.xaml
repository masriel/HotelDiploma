<Window x:Class="Hotel.Pages.AdminPanelView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Панель админимтратора" Height="400" Width="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        FontSize="18" FontFamily="Montserrat">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="TitleText">
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="materialDesign:Card" x:Key="Card">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Opacity" Value=".8"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="List">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="10 25 10 10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ListItem">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#7986CB"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Ellipse Width="180"
            Height="180"
            VerticalAlignment="Top"
            Fill="#483a87"
            Margin="-62,26,157,0"
            Opacity="0.2" Grid.Row="2"/>
        <Ellipse Width="230"
            Height="230"
            VerticalAlignment="Bottom"
            Fill="#6d5e9f"
            Margin="182,0,138,-95"
            Opacity="0.4" Grid.ColumnSpan="2" Grid.Row="2"/>
        <Ellipse Width="185"
            Height="185"
            VerticalAlignment="Bottom"
            Fill="#b6abce"
            Margin="28,0,62,-50"
            Opacity="0.3" Grid.Row="2"/>
        <Ellipse Width="230"
            Height="230"
            VerticalAlignment="Bottom"
            Fill="#9184b7"
            Margin="86,0,-41,-30"
            Opacity="0.6" Grid.Column="1" Grid.RowSpan="2" Grid.Row="1"/>

        <StackPanel Grid.Row="0" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="LogoutButton"
                    ToolTip="Icon" 
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="5 0 5 0"
                    Click="LogoutButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Logout}"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="CloseButton"
                    ToolTip="Icon" 
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="0 0 2 0"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Close}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Grid.Column="0"
                             HorizontalAlignment="Center"
                             Style="{StaticResource Card}"
                             MouseLeftButtonUp="Users_MouseLeftButtonUp">
            <Grid Margin="5">
                <Border Grid.Row="0"
                    Background="#fdfdfd"
                    CornerRadius="120"
                    Opacity="0.45"
                    Height="65" Width="65"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10">
                    <Grid>
                        <materialDesign:PackIcon Kind="AccountGroup"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <StackPanel Style="{StaticResource List}">
                    <TextBlock Text="ДОБАВЛЕНИЕ"
                               Style="{StaticResource ListItem}"/>
                    <TextBlock Text="УДАЛЕНИЕ"
                               Style="{StaticResource ListItem}"/>
                    <TextBlock Text="РЕДАКТИРОВАНИЕ"
                               Style="{StaticResource ListItem}"/>
                </StackPanel>
                <TextBlock Text="ПОЛЬЗОВАТЕЛИ"
                           Style="{StaticResource TitleText}"/>
            </Grid>
        </materialDesign:Card>
        
        <materialDesign:Card Grid.Row="1" Grid.Column="1"
                             Name="Database"
                             HorizontalAlignment="Center"
                             Style="{StaticResource Card}"
                             MouseLeftButtonUp="Database_MouseLeftButtonUp">
            <Grid>
                <Border Grid.Row="0"
                        Background="#fdfdfd"
                        CornerRadius="120"
                        Opacity="0.45"
                        Height="65" Width="65"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10">
                    <Grid>
                        <materialDesign:PackIcon Kind="Database"
                                Width="60"
                                Height="60"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <StackPanel Style="{StaticResource List}">
                    <TextBlock Text="КЛИЕНТЫ"
                               Style="{StaticResource ListItem}"/>
                    <TextBlock Text="БРОНИРОВАНИЕ"
                               Style="{StaticResource ListItem}"/>
                    <TextBlock Text="НОМЕРА И УСЛУГИ"
                               Style="{StaticResource ListItem}"/>
                </StackPanel>
                <TextBlock Text="БАЗА ДАННЫХ"
                           Style="{StaticResource TitleText}"/>
            </Grid>
            
        </materialDesign:Card>
        
        <materialDesign:Card Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Name="DatabaseControl"
                             HorizontalAlignment="Center"
                             Style="{StaticResource Card}"
                             MouseLeftButtonUp="DatabaseControl_MouseLeftButtonUp">
            <Grid>
                <Border Grid.Row="0"
                        Background="#fdfdfd"
                        CornerRadius="120"
                        Opacity="0.45"
                        Height="65" Width="65"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10">
                    <Grid>
                        <materialDesign:PackIcon Kind="DatabaseCog"
                                Width="60"
                                Height="60"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <StackPanel Style="{StaticResource List}">
                    <TextBlock Text="КОПИРОВАНИЕ"
                               Style="{StaticResource ListItem}"/>
                    <TextBlock Text="ВОССТАНОВЛЕНИЕ"
                               Style="{StaticResource ListItem}"/>
                    <TextBlock Text="ИМПОРТ/ЭКСПОРТ"
                               Style="{StaticResource ListItem}"/>
                </StackPanel>
                <TextBlock Text="УПРАВЛЕНИЕ БАЗОЙ"
                           Style="{StaticResource TitleText}"/>
            </Grid>
            
        </materialDesign:Card>
    </Grid>
</Window>
