<Window x:Class="Hotel.Pages.AddClient"
        x:Name="AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls1="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Добавление клиента" Height="400" Width="800"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        FontSize="21" FontFamily="Montserrat" 
        Foreground="#5C6BC0" FontWeight="Medium"
        Closing="AddClientWindow_Closing">
    <Window.Resources>
        <Style x:Key="NameText" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LittleTitle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MaskedTextBox" TargetType="controls1:MaskedTextBox">
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <materialDesign:Card Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="5" Orientation="Horizontal">
                    <TextBox x:Name="LastName"
                             materialDesign:HintAssist.Hint="Фамилия"
                             Style="{StaticResource NameText}"
                             PreviewTextInput="TextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"/>
                    <TextBox x:Name="FirstName"
                             materialDesign:HintAssist.Hint="Имя"
                             Style="{StaticResource NameText}"
                             PreviewTextInput="TextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"/>
                    <TextBox x:Name="MiddleName"
                             materialDesign:HintAssist.Hint="Отчество"
                             Style="{StaticResource NameText}"
                             PreviewTextInput="TextBox_PreviewTextInput"
                             TextChanged="TextBox_TextChanged"/>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="AddClientButton"
                        ToolTip="Icon" Margin="5"
                        Width="40" Height="40"
                        BorderThickness="0"
                        Background="Transparent"
                        HorizontalAlignment="Right"
                        Click="AddClientButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Add}"/>
                        </Style>
                    </Button.Style>
                </Button>

                <materialDesign:Card Grid.Row="1" Grid.Column="0"
                                     Margin="8" Background="#E8EAF6">
                    <StackPanel Margin="5" Orientation="Vertical">
                        <TextBlock Text="ПЕРСОНАЛЬНАЯ ИНФОРМАЦИЯ"
                                   Style="{StaticResource LittleTitle}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="5">
                            <TextBlock Text="ТЕЛ. НОМЕР: "
                                       FontWeight="DemiBold"
                                       Style="{StaticResource LittleTitle}"/>
                            <controls1:MaskedTextBox Mask="0 000 000 00 00"
                                                     x:Name="PhoneNumber"
                                                     Style="{StaticResource MaskedTextBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical"
                                    VerticalAlignment="Center"
                                    Margin="5">
                            <TextBlock Text="ЭЛ. ПОЧТА: "
                                       FontWeight="DemiBold"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource LittleTitle}"/>
                            <TextBox x:Name="Email"
                                     TextWrapping="Wrap" Margin="5"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     PreviewTextInput="Email_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="5">
                            <TextBlock Text="ДАТА РОЖДЕНИЯ: "
                                       FontWeight="DemiBold"
                                       Style="{StaticResource LittleTitle}"/>
                            <DatePicker x:Name="BirthDate"
                                        SelectedDateChanged="BirthDate_SelectedDateChanged"/>
                        </StackPanel>
                    </StackPanel>

                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Grid.Column="1"
                                     Margin="8" Background="#E8EAF6">
                    <Grid Margin="5">
                        <StackPanel Name="PassportView" Visibility="Visible"
                                    Orientation="Vertical">
                            <TextBlock Text="ПАСПОРТНЫЕ ДАННЫЕ"
                                       Style="{StaticResource LittleTitle}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <TextBlock Text="СЕРИЯ НОМЕР: "
                                           FontWeight="DemiBold"
                                           Style="{StaticResource LittleTitle}"/>
                                <controls1:MaskedTextBox Mask="0000 000000"
                                                         x:Name="SeriesNumber"
                                                         Style="{StaticResource MaskedTextBox}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <TextBlock Text="ДАТА ВЫДАЧИ: "
                                           FontWeight="DemiBold"
                                           Style="{StaticResource LittleTitle}"/>
                                <controls1:MaskedTextBox Mask="00/00/0000 г/"
                                                         x:Name="IssueDate"
                                                         Style="{StaticResource MaskedTextBox}"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical"
                                        Margin="5">
                                <TextBlock Text="КЕМ ВЫДАН: "
                                           FontWeight="DemiBold" HorizontalAlignment="Left"
                                           Style="{StaticResource LittleTitle}"/>
                                <TextBox x:Name="IssuingAuthority"
                                         TextWrapping="Wrap"
                                         Margin="5"
                                         Style="{StaticResource MaterialDesignTextBox}"
                                         PreviewTextInput="TextBox_PreviewTextInput"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="BirthCertificateView" Visibility="Collapsed">
                            <TextBlock Text="СВИДЕТЕЛЬСТВО О РОЖДЕНИИ"
                                       Style="{StaticResource LittleTitle}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <TextBlock Text="РЕГ. НОМЕР: "
                                           FontWeight="DemiBold"
                                           Style="{StaticResource LittleTitle}"/>
                                <controls1:MaskedTextBox Mask="AAA000000"
                                                         x:Name="RegNumber"
                                                         FontWeight="DemiBold"
                                                         Style="{StaticResource MaskedTextBox}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <TextBlock Text="ДАТА ВЫДАЧИ: "
                                           FontWeight="DemiBold"
                                           Style="{StaticResource LittleTitle}"/>
                                <controls1:MaskedTextBox Mask="00/00/0000 г/"
                                                         x:Name="BirthCertificateIssueDate"
                                                         Style="{StaticResource MaskedTextBox}"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical"
                                        Margin="5">
                                <TextBlock Text="КЕМ ВЫДАН: "
                                           FontWeight="DemiBold" HorizontalAlignment="Left"
                                           Style="{StaticResource LittleTitle}"/>
                                <TextBox x:Name="BirthCertificateIssuingAuthority"
                                         TextWrapping="Wrap"
                                         Margin="5"
                                         Style="{StaticResource MaterialDesignTextBox}"
                                         PreviewTextInput="TextBox_PreviewTextInput"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
