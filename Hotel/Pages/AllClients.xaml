<Window x:Class="Hotel.Pages.AllClients"
        x:Name="ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel.DatabaseControl.TabControl"
        mc:Ignorable="d"
        Title="Клиенты гостиницы" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        FontSize="16" FontFamily="Montserrat" Foreground="#5C6BC0"
        Closing="ClientsWindow_Closing">
    <Grid>
        <local:ClientsView />
    </Grid>
</Window>
