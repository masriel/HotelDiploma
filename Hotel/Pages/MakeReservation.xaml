<Window x:Class="Hotel.Pages.MakeReservation"
        x:Name="ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Hotel.Pages"
        mc:Ignorable="d"
        Title="Оформление" Height="350" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        FontSize="20" FontFamily="Montserrat" Foreground="#5C6BC0"
        Loaded="ReservationWindow_Loaded">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="TitleText">
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="Margin" Value="0 10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="8">
            <TextBlock Text="ЗАЕЗД: "
                       Style="{StaticResource TitleText}"/>
            <DatePicker x:Name="ArrivalDatePicker"
                        FontWeight="DemiBold" FontSize="20"
                        Style="{StaticResource MaterialDesignDatePicker}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="8">
            <TextBlock Text="ВЫЕЗД: "
                       Style="{StaticResource TitleText}"/>
            <DatePicker x:Name="DepartureDatePicker"
                        FontWeight="DemiBold" FontSize="20"
                        Style="{StaticResource MaterialDesignDatePicker}"/>
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="КОМНАТА" Margin="8"
                   Style="{StaticResource TitleText}"/>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  x:Name="SelectRoomBox" Margin="8"
                  VerticalAlignment="Center"/>

        <StackPanel Grid.Row="2" Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="ПОСЕТИТЕЛИ"
                       Style="{StaticResource TitleText}"/>
            <Button x:Name="AddClientButton"
                    ToolTip="Icon"
                    Width="30" Height="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="AddClientButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Add}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="ПИТАНИЕ"
                       Style="{StaticResource TitleText}"/>
            <Button x:Name="AddMealButton"
                    ToolTip="Icon"
                    Width="30" Height="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="AddMealButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Add}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ListBox Grid.Row="3" Grid.Column="0"
                 x:Name="ClientsList"
                 FontFamily="Montserrat"
                 Foreground="#5C6BC0"
                 FontSize="16" HorizontalAlignment="Center"
                 Padding="10 0"
                 Style="{StaticResource MaterialDesignChoiceChipListBox}"
                 MouseDoubleClick="ClientsList_MouseDoubleClick"/>

        <ListBox Grid.Row="3" Grid.Column="1"
                 x:Name="MealsList"
                 FontFamily="Montserrat"
                 Foreground="#5C6BC0"
                 FontSize="16" HorizontalAlignment="Center"
                 Padding="10 0"
                 Style="{StaticResource MaterialDesignChoiceChipListBox}"
                 MouseDoubleClick="MealsList_MouseDoubleClick"/>

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="AddBookingButton"
                Content="ОФОРМИТЬ"
                Margin="100 10 100 5"
                Click="AddBookingButton_Click"/>
    </Grid>
</Window>
