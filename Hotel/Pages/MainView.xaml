<Window x:Class="Hotel.Pages.MainView"
        x:Name="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Hotel.ItemControl"
        mc:Ignorable="d"
        Title="Главная" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Background="#E8EAF6"
        FontSize="16" FontFamily="Montserrat" Foreground="#5C6BC0"
        Loaded="MainWindow_Loaded">

    <Window.Resources>
        <Style TargetType="materialDesign:Card" x:Key="Card">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Border" x:Key="Icon">
            <Setter Property="Background" Value="#fdfdfd"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Width" Value="55"/>
            <Setter Property="CornerRadius" Value="120"/>
            <Setter Property="Margin" Value="10 0"/>
            <Setter Property="Opacity" Value=".8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="materialDesign:PackIcon" x:Key="PackIcon">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TitleText">
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="Margin" Value="0 10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="LogoutButton"
                    ToolTip="Icon" 
                    Height="30" Width="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="LogoutButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Logout}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="HideButton"
                    ToolTip="Icon" 
                    Height="30" Width="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="HideButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Minus}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="FullScreenButton"
                    ToolTip="Icon" 
                    Height="30" Width="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Visibility="Collapsed"
                    Click="FullScreenButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Fullscreen}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="SmallScreenButton"
                    ToolTip="Icon" 
                    Height="30" Width="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Visibility="Visible"
                    Click="SmallScreenButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=FullscreenExit}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="CloseButton"
                    ToolTip="Icon" 
                    Height="30" Width="30"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Close}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="10 0"
                   HorizontalAlignment="Left"
                   Style="{StaticResource TitleText}">
            <Run Text="Сотрудник:"/>
            <Run x:Name="WorkerName"/>
        </TextBlock>

        <materialDesign:Card Grid.Row="1" Grid.Column="0"
                             Name="Clients"
                             Style="{StaticResource Card}"
                             PreviewMouseUp="Clients_PreviewMouseUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Style="{StaticResource Icon}">
                    <Grid>
                        <materialDesign:PackIcon Kind="HumanMaleFemaleChild"
                                                 Style="{StaticResource PackIcon}">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="КЛИЕНТЫ"
                           Margin="10 10 30 10"
                           Style="{StaticResource TitleText}"/>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Grid.Column="1"
                             Name="RegistrateBooking"
                             Style="{StaticResource Card}"
                             PreviewMouseUp="RegistrateBooking_PreviewMouseUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Style="{StaticResource Icon}">
                    <Grid>
                        <materialDesign:PackIcon Kind="Bed"
                                                 Style="{StaticResource PackIcon}">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="ЗАСЕЛЕНИЕ"
                           Margin="10 10 30 10"
                           Style="{StaticResource TitleText}"/>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Grid.Column="2"
                             Name="Bookings"
                             Style="{StaticResource Card}"
                             PreviewMouseUp="Bookings_PreviewMouseUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".4*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Style="{StaticResource Icon}">
                    <Grid>
                        <materialDesign:PackIcon Kind="BookMultiple"
                                                 Style="{StaticResource PackIcon}">
                            <materialDesign:PackIcon.Foreground>
                                <LinearGradientBrush>
                                    <GradientStop Color="#303F9F" Offset="0.5"/>
                                    <GradientStop Color="#7986CB" Offset="0.4"/>
                                </LinearGradientBrush>
                            </materialDesign:PackIcon.Foreground>
                        </materialDesign:PackIcon>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="ОФОРМЛЕНИЕ"
                           Style="{StaticResource TitleText}"/>
            </Grid>
        </materialDesign:Card>

        <TextBox Grid.Row="2" Grid.Column="0"
                 x:Name="SearchText"
                 materialDesign:HintAssist.Hint="Название номера"
                 VerticalAlignment="Center"
                 Margin="8"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

        <ComboBox Grid.Row="2" Grid.Column="1"
                  x:Name="FilterBox"
                  materialDesign:HintAssist.Hint="Фильтровать по"
                  Margin="8"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}">
            <ComboBoxItem Content="Статус"/>
            <ComboBoxItem Content="Кол-во жильцов"/>
            <ComboBoxItem Content="Цена"/>
        </ComboBox>

        <Grid Grid.Row="2" Grid.Column="2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="8">
                <Button x:Name="DescButton"
                        ToolTip="Icon"
                        BorderThickness="0"
                        Background="Transparent"
                        Width="40" Height="40"
                        Click="DescButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=SortDescending}"/>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="AscButton"
                        ToolTip="Icon"
                        BorderThickness="0"
                        Background="Transparent"
                        Width="40" Height="40"
                        Click="AscButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=SortAscending}"/>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ClearButton"
                        ToolTip="Icon"
                        BorderThickness="0"
                        Background="Transparent"
                        Width="40" Height="40"
                        Click="ClearButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=FilterRemoveOutline}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button x:Name="UpdateStatusButton"
                    ToolTip="Icon"
                    BorderThickness="0"
                    Background="Transparent"
                    Width="40" Height="40"
                    Margin="20 10"
                    HorizontalAlignment="Right"
                    Click="UpdateStatusButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=RefreshCircle}"/>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
      
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">
                <Button x:Name="UpButton"
                        BorderThickness="0"
                        Width="30" Height="30"
                        Click="UpButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=MenuLeft}"/>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Margin="10">
                    <Run Name="CurrentPage"/>
                    <Run Text="/"/>
                    <Run Name="TotalPages"/>
                </TextBlock>
                <Button x:Name="DownButton"
                        BorderThickness="0"
                        Width="30" Height="30"
                        Click="DownButton_Click">
                    <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=MenuRight}"/>
                    </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
            <ItemsControl Grid.Row="0" x:Name="Rooms"
                          VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height=".2*"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:Card Grid.Column="0" Grid.Row="1"
                                                        Padding="5" Margin="10"
                                                        Width="300" Height="300"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Photo}"/>
                                </materialDesign:Card>

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                            Margin="15 3" Text="{Binding Type}"
                                            FontWeight="ExtraBold" FontSize="46"
                                            VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                            Margin="10" VerticalAlignment="Top"
                                            HorizontalAlignment="Right" FontWeight="Light"
                                            Foreground="#3949AB">
                                    <Run Text="Статус:"/>
                                    <Run Text="{Binding IsFree}"/>
                                </TextBlock>

                                <materialDesign:Card Grid.Row="1" Grid.Column="1"
                                                        Margin="10" Background="#E8EAF6">
                                    <Grid Margin="5">
                                        <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Top">
                                            <TextBlock FontSize="30" TextWrapping="Wrap">
                                                <Run Text="{Binding Description}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="34">
                                                <Run Text="Кол-во мест:"
                                                        FontWeight="ExtraBold"/>
                                                <Run Text="{Binding Occupancy}"/>
                                                <Run Text="чел."/>
                                            </TextBlock>
                                            <TextBlock FontSize="34">
                                                <Run Text="Номер:"
                                                        FontWeight="ExtraBold"/>
                                                <Run Text="{Binding Number}"
                                                        FontWeight="DemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock FontSize="32" FontWeight="Light"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right"
                                                    Foreground="#3949AB">
                                            <Run Text="{Binding Cost}"/>
                                            <Run Text="руб/ночь"/>
                                        </TextBlock>
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>

    
