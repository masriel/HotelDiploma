<Window x:Class="Hotel.Pages.Login"
        x:Name="LoginWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Вход" Height="645" Width="875"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent"
        FontSize="20" FontFamily="Montserrat"
        Loaded="LoginWin_Loaded">

    <Window.Resources>
        <Style x:Key="MaterialDesignTitleTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Margin" Value="0 10"/>
        </Style>

        <Style TargetType="TextBox" x:Key="MaterialDesignInputTextBox"
               BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="PasswordBox" x:Key="MaterialDesignPasswordBox"
               BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="1"
                              Opacity="0.4"/>
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="1.22*"/>
        </Grid.ColumnDefinitions>
        <!--Левая часть окна-->
        <Border Background="#dad4e7"
                ClipToBounds="True">
            <Grid>
                <Ellipse Width="500"
                         Height="500"
                         VerticalAlignment="Bottom"
                         Fill="#9184b7"
                         Margin="50 0 0 -200"
                         Opacity="0.6"/>

                <!--Заголовки-->
                <StackPanel VerticalAlignment="Top">
                    <Border Background="#fdfdfd"
                            CornerRadius="120"
                            Opacity="0.45"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Height="250"
                            Width="250"
                            Margin="0 40 0 80">
                        <Grid>
                            <Ellipse Width="240"
                                 Height="240"
                                 StrokeThickness="4">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#5C6BC0"
                                              Offset="0.15"/>
                                        <GradientStop Color="#7986CB"
                                              Offset="0.2"/>
                                        <GradientStop Color="#5C6BC0"
                                              Offset="0.3"/>
                                        <GradientStop Color="#7986CB"
                                              Offset="0.5"/>
                                        <GradientStop Color="#5C6BC0"
                                              Offset="0.6"/>
                                        <GradientStop Color="#7986CB"
                                              Offset="0.8"/>
                                        <GradientStop Color="#5C6BC0"
                                              Offset="0.9"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <materialDesign:PackIcon Kind="Account"
                                                 Width="120"
                                                 Height="120"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                <materialDesign:PackIcon.Foreground>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#303F9F"
                                              Offset="0.5"/>
                                        <GradientStop Color="#7986CB"
                                              Offset="0.4"/>
                                    </LinearGradientBrush>
                                </materialDesign:PackIcon.Foreground>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Border>
                </StackPanel>

                <Ellipse Width="300"
                         Height="300"
                         VerticalAlignment="Bottom"
                         Fill="#483a87"
                         Margin="-450 0 0 30"
                         Opacity="0.3"/>
                <Ellipse Width="400"
                         Height="400"
                         VerticalAlignment="Bottom"
                         Fill="#6d5e9f"
                         Margin="-320 0 0 -120"
                         Opacity="0.6"/>
                <Ellipse Width="250"
                         Height="250"
                         VerticalAlignment="Bottom"
                         Fill="#b6abce"
                         Margin="-300 0 0 -120"
                         Opacity="0.5"/>
                <Ellipse Width="400"
                         Height="400"
                         VerticalAlignment="Bottom"
                         Fill="#9184b7"
                         Margin="280 0 0 -70"
                         Opacity="0.8"/>
            </Grid>
        </Border>
        <!--Правая сторона окна-->
        <Border Grid.Column="1" Grid.ColumnSpan="2"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="2.5*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width=".1*"/>
                </Grid.ColumnDefinitions>

                <!--Иконка выхода-->
                <Button Grid.Row="0" Grid.Column="1"
                        ToolTip="Icon" x:Name="CloseButton"
                        VerticalAlignment="Top"
                        Margin="0 10"
                        HorizontalAlignment="Center"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Close}"/>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           FontSize="46" FontFamily="Montserrat"
                           FontWeight="Regular"
                           Foreground="#7986CB"
                           Text="ВХОД В СИСТЕМУ">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#1A237E" Direction="0" ShadowDepth="2" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10 20" Padding="10">
                    <Grid Name="InputGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="1.2*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width=".1*"/>
                        </Grid.ColumnDefinitions>

                        <!--Поля для ввода-->
                        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                 x:Name="LoginText"
                                 materialDesign:HintAssist.Hint="Логин"
                                 VerticalAlignment="Bottom"
                                 Style="{StaticResource MaterialDesignInputTextBox}"/>

                        <PasswordBox Grid.Row="1" Grid.Column="0"
                                     x:Name="PasswordText"
                                     materialDesign:HintAssist.Hint="Пароль"
                                     Visibility="Visible"
                                     VerticalAlignment="Bottom"
                                     Style="{StaticResource MaterialDesignPasswordBox}"/>
                        <TextBox Grid.Row="1" Grid.Column="0"
                                 x:Name="HelperBoxForPassword"
                                 materialDesign:HintAssist.Hint="Пароль"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 VerticalAlignment="Bottom"
                                 Style="{StaticResource MaterialDesignInputTextBox}"/>

                        <!--показать/скрыть пароль-->
                        <Button Grid.Row="1" Grid.Column="1"
                                x:Name="ShowPwdButton"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0 5"
                                ToolTip="Icon"
                                BorderThickness="0"
                                Background="Transparent"
                                Visibility="Visible"
                                PreviewMouseLeftButtonDown="ShowPwdButton_MouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ShowPwdButton_MouseLeftButtonUp">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Eye}"/>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!--кнопка входа-->
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                x:Name="LoginButton"
                                Background="#5C6BC0"
                                Content="ВОЙТИ"
                                Click="LoginButton_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   x:Name="TimerText"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed">
                            <Run Text="00"/>
                            <Run Text=":"/>
                            <Run Name="SecondsText"
                                 Text=""/>
                        </TextBlock>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Border>
    </Grid>
</Window>
